{
  "name": "DarkMode_ForestGreen_SoftBlack",
  "dataColors": [
    "#4CAF50",   // Primary Forest Green Accent
    "#FFEB3B",   // Secondary Yellow/Gold
    "#F44336",   // Error/Warning (Red)
    "#A5D6A7",   // Light Green
    "#1B5E20",   // Dark Green
    "#757575",   // Muted Grey
    "#E8E8E8",   // Lightest Text/Primary Foreground
    "#B0BEC5"    // Muted Text/Secondary Foreground
  ],
  "visualStyles": {
    "*": {
      "*": {
        "outlines": [
          {
            "show": true,
            "color": "#3A3A3A"
          }
        ],
        "background": [
          {
            "show": true,
            "color": "#1A1A1A"
          }
        ]
      }
    },
    "table": {
      "*": {
        "header": [
          {
            "background": "#292929",
            "fontColor": "#E8E8E8"
          }
        ],
        "values": [
          {
            "background": "#1A1A1A",
            "fontColor": "#E8E8E8",
            "altFontColor": "#A5D6A7"
          }
        ]
      }
    }
  },
  "textClasses": {
    "label": {
      "color": "#B0BEC5"
    },
    "callout": {
      "color": "#4CAF50"
    },
    "title": {
      "color": "#4CAF50"
    },
    "header": {
      "color": "#E8E8E8"
    }
  },
  "foreground": "#E8E8E8",       // Primary text color (soft white)
  "foregroundNeutral": "#B0BEC5", // Secondary text color (light blue-grey)
  "background": "#1A1A1A",       // Main background (Soft Black/Very Dark Grey)
  "backgroundNeutral": "#292929", // Element background (Slightly lighter dark grey)
  "accent": "#4CAF50"             // Accent color (Forest Green)
}